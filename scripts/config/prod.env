# RumiAI production runtime config for rumi.robinverse.me.
APP_ENV=prod

# Public frontend URLs embedded by Next.js at build time.
NEXT_PUBLIC_API_BASE=https://rumi.robinverse.me
NEXT_PUBLIC_LANGGRAPH_API_URL=https://rumi.robinverse.me/lg

# Bind internal services to loopback. Nginx exposes only 80/443.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3001
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=2024
CHROMA_BIND_HOST=127.0.0.1
CHROMA_PORT=8001

# Backend app env. Override DATA_DIR in the shell if your ECS uses another disk.
DATA_DIR=/data/rumi-ai
CHROMA_HOST=127.0.0.1

