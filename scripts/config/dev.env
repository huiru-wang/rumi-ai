# RumiAI development runtime config.
APP_ENV=dev

# Public frontend URLs embedded by Next.js in dev mode.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024

# Local service ports.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LANGGRAPH_HOST=0.0.0.0
LANGGRAPH_PORT=2024
CHROMA_BIND_HOST=0.0.0.0
CHROMA_PORT=8001

# Backend app env.
DATA_DIR=./data
CHROMA_HOST=localhost
